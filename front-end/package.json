    "i18next": "^25.6.3",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.3.5",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.20.0",
